.device-list-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg-secondary);
}

.toolbar {
  background-color: var(--color-bg-primary) !important;
  color: var(--color-text-primary) !important;
  border-bottom: 1px solid var(--color-border-default);
  box-shadow: none !important;
  padding: 8px 24px;
  min-height: 64px;

  .toolbar-icon {
    margin-right: 12px;
    color: var(--color-text-secondary);
  }

  .toolbar-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .spacer {
    flex: 1 1 auto;
  }

  button {
    margin-left: 8px;
    font-size: 14px;
    
    mat-icon {
      margin-right: 6px;
      font-size: 18px;
      width: 18px;
      height: 18px;
    }
  }

  .view-toggle {
    margin-right: 8px;
  }

  .discover-button {
    margin-left: 8px;
  }
}

.content-container {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
}

.info-banner {
  padding: 16px;
  background-color: var(--color-info-bg);
  color: var(--color-info);
  border: 1px solid rgba(9, 105, 218, 0.2);
  border-radius: 6px;
  margin-bottom: 24px;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-size: 14px;

  mat-icon {
    color: var(--color-info);
    flex-shrink: 0;
  }
}

.error-banner {
  padding: 16px;
  background-color: var(--color-danger-bg);
  color: var(--color-danger);
  border: 1px solid rgba(209, 36, 47, 0.2);
  border-radius: 6px;
  margin-bottom: 24px;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-size: 14px;

  mat-icon {
    color: var(--color-danger);
    flex-shrink: 0;
  }
}

.discovery-progress,
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
  gap: 20px;

  p {
    color: var(--color-text-secondary);
    font-size: 14px;
  }
}

.devices-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
  gap: 16px;
}

.device-card {
  background-color: var(--color-bg-primary);
  border: 1px solid var(--color-border-default);
  border-radius: 6px;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.2s ease, border-color 0.2s ease;

  &:hover {
    border-color: var(--color-border-muted);
    box-shadow: var(--shadow-md);
  }

  &.device-card-offline {
    background-color: var(--color-bg-secondary);
    opacity: 0.7;
  }

  mat-card-header {
    padding: 16px;
    border-bottom: 1px solid var(--color-border-muted);

    mat-icon[mat-card-avatar] {
      width: 32px;
      height: 32px;
      font-size: 20px;
      display: flex;
      align-items: center;
justify-content: center;
      border-radius: 6px;
      margin-right: 12px;

      &.online {
        color: var(--color-success);
        background-color: var(--color-success-bg);
      }

      &.offline {
        color: var(--color-offline);
        background-color: var(--color-offline-bg);
      }
    }

    ::ng-deep .mat-mdc-card-header-text {
      margin: 0;
    }
  }

  mat-card-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 4px;
  }

  mat-card-subtitle {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }

  mat-card-content {
    padding: 16px;
  }

  mat-card-actions {
    padding: 12px 16px;
    background-color: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border-muted);
    display: flex;
    gap: 8px;
    flex-wrap: wrap;

    button {
      font-size: 13px;
      
      mat-icon {
        font-size: 16px;
        width: 16px;
        height: 16px;
        margin-right: 4px;
      }
    }
  }

  mat-card-footer {
    padding: 10px 16px;
    background-color: var(--color-bg-tertiary);
    border-top: 1px solid var(--color-border-muted);

    small {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--color-text-tertiary);
      font-size: 12px;

      .footer-icon {
        font-size: 14px;
        width: 14px;
        height: 14px;
      }
    }
  }
}

.device-info {
  margin-bottom: 16px;

  .info-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    font-size: 13px;
    line-height: 1.4;

    &:last-child {
      margin-bottom: 0;
    }

    .info-icon {
      color: var(--color-text-tertiary);
      font-size: 16px;
      width: 16px;
      height: 16px;
      flex-shrink: 0;

      &.power-icon {
        color: var(--color-warning);
      }
    }

    .info-label {
      font-weight: 500;
      color: var(--color-text-secondary);
      min-width: 100px;
    }

    .info-value {
      color: var(--color-text-primary);
      flex: 1;

      &.power-value {
        strong {
          color: var(--color-warning);
          font-size: 15px;
          font-weight: 600;
        }

        .power-details {
          font-size: 12px;
          color: var(--color-text-tertiary);
          margin-left: 8px;
        }
      }
    }
  }
}

.device-state {
  margin-bottom: 16px;

  mat-chip-set {
    display: flex;
    justify-content: flex-start;
  }

  mat-chip {
    font-weight: 500;
    font-size: 12px;
    border-radius: 12px;

    &.state-on {
      background-color: var(--color-success-bg) !important;
      color: var(--color-success) !important;
      border: 1px solid rgba(26, 127, 55, 0.3);
    }

    &.state-off {
      background-color: var(--color-offline-bg) !important;
      color: var(--color-offline) !important;
      border: 1px solid var(--color-border-default);
    }

    mat-icon {
      margin-right: 4px;
      font-size: 16px;
    }
  }
}

mat-chip {
  font-size: 11px;
  padding: 2px 8px;
  height: 20px;
  border-radius: 10px;
  font-weight: 500;

  &.online-chip {
    background-color: var(--color-success-bg) !important;
    color: var(--color-success) !important;
    border: 1px solid rgba(26, 127, 55, 0.3);
  }

  &.offline-chip {
    background-color: var(--color-offline-bg) !important;
    color: var(--color-offline) !important;
    border: 1px solid var(--color-border-default);
  }

  &.room-chip {
    background-color: var(--color-info-bg) !important;
    color: var(--color-info) !important;
    border: 1px solid rgba(9, 105, 218, 0.3);
    margin-left: 6px;

    mat-icon {
      font-size: 14px;
      width: 14px;
      height: 14px;
      margin-right: 2px;
    }
  }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 20px;
  text-align: center;

  .empty-icon {
    font-size: 64px;
    width: 64px;
    height: 64px;
    color: var(--color-text-tertiary);
    margin-bottom: 16px;
  }

  h2 {
    color: var(--color-text-primary);
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  p {
    color: var(--color-text-secondary);
    font-size: 14px;
  }
}

// List View Styles
.devices-list {
  .room-section {
    margin-bottom: 24px;

    .room-header {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 16px;
      font-weight: 600;
      color: var(--color-text-primary);
      padding: 12px 16px;
      background: var(--color-bg-primary);
      border: 1px solid var(--color-border-default);
      border-radius: 6px 6px 0 0;
      border-bottom: none;

      mat-icon {
        color: var(--color-text-secondary);
        font-size: 20px;
        width: 20px;
        height: 20px;
      }

      .device-count {
        font-size: 12px;
        color: var(--color-text-tertiary);
        font-weight: 500;
        background-color: var(--color-bg-tertiary);
        padding: 2px 8px;
        border-radius: 10px;
        margin-left: 8px;
      }
    }

    .room-devices {
      background: var(--color-bg-primary);
      border: 1px solid var(--color-border-default);
      border-radius: 0 0 6px 6px;
      overflow: hidden;

      .device-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px;
        border-bottom: 1px solid var(--color-border-muted);
        transition: background-color 0.15s ease;

        &:last-child {
          border-bottom: none;
        }

        &:hover {
          background-color: var(--color-bg-secondary);
        }

        &.device-offline {
          opacity: 0.6;
        }

        .device-main-info {
          display: flex;
          align-items: center;
          gap: 16px;
          flex: 1;
          min-width: 0;

          .device-status-icon {
            font-size: 20px;
            width: 20px;
            height: 20px;
            flex-shrink: 0;

            &.status-online {
              color: var(--color-success);
            }

            &.status-offline {
              color: var(--color-offline);
            }
          }

          .device-name-type {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 180px;
            max-width: 250px;
            flex-shrink: 0;

            .device-name {
              font-size: 14px;
              font-weight: 600;
              color: var(--color-text-primary);
              overflow: hidden;
              text-overflow: ellipsis;
              white-space: nowrap;
            }

            .device-type {
              font-size: 12px;
              color: var(--color-text-secondary);
              overflow: hidden;
              text-overflow: ellipsis;
              white-space: nowrap;
            }
          }

          .device-state-chip {
            font-weight: 500;
            font-size: 11px;
            padding: 4px 10px;
            height: 22px;
            border-radius: 11px;

            &.state-on {
              background-color: var(--color-success-bg) !important;
              color: var(--color-success) !important;
              border: 1px solid rgba(26, 127, 55, 0.3);
            }

            &.state-off {
              background-color: var(--color-offline-bg) !important;
              color: var(--color-offline) !important;
              border: 1px solid var(--color-border-default);
            }
          }

          .device-power {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--color-warning);
            font-size: 13px;
            font-weight: 600;
            flex: 1;
            min-width: 0;

            .power-icon {
              font-size: 18px;
              width: 18px;
              height: 18px;
              flex-shrink: 0;
            }

            .power-value {
              font-weight: 600;
              white-space: nowrap;
            }

            .power-details {
              font-size: 11px;
              color: var(--color-text-tertiary);
              margin-left: 4px;
              white-space: nowrap;
            }

            .energy-total {
              font-size: 11px;
              color: var(--color-text-tertiary);
              font-weight: 400;
              margin-left: 6px;
              white-space: nowrap;
              overflow: hidden;
              text-overflow: ellipsis;
            }
          }
        }

        .device-actions {
          display: flex;
          gap: 4px;
          flex-shrink: 0;
        }
      }
    }
  }
}

.view-toggle {
  margin-right: 8px;
}

@media (max-width: 1024px) {
  .devices-grid {
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  }
}

@media (max-width: 768px) {
  .content-container {
    padding: 16px;
  }

  .toolbar {
    padding: 8px 16px;
    flex-wrap: wrap;
    min-height: auto;

    button {
      font-size: 12px;
      margin-left: 4px;
      
      mat-icon {
        margin-right: 4px;
      }
      
      span {
        display: none;
      }
    }
  }

  .devices-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .devices-list {
    .room-section {
      .room-devices {
        .device-row {
          flex-direction: column;
          align-items: flex-start;
          gap: 12px;
          padding: 12px;

          .device-main-info {
            width: 100%;
            flex-wrap: wrap;

            .device-name-type {
              min-width: 0;
              max-width: 100%;
              flex: 1;
            }

            .device-power {
              width: 100%;
            }
          }

          .device-actions {
            width: 100%;
            justify-content: flex-end;
          }
        }
      }
    }
  }
}
